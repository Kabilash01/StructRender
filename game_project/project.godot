; StructRender M0 — "Arena Collector"
; Engine pinned to Godot 4.7.2-stable (see /.godot-version). config_version=5 is Godot 4.x.
; Renderer: Forward+ (rendering/renderer/rendering_method below). This choice is PINNED
; per agent/specifications/m0_minimal_game.md — do not change without a KB Decision Log note.

config_version=5

[application]

config/name="StructRender Arena Collector (M0)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/print_header=true

[autoload]

GameState="*res://scripts/game_state.gd"
GameLog="*res://scripts/logger.gd"
SimDriver="*res://scripts/sim_driver.gd"

[debug]

gdscript/warnings/unassigned_variable=1
gdscript/warnings/unused_variable=1

[physics]

; Fixed physics tick for deterministic simulation (KB §2 determinism, spec "Fixed physics tick").
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"

